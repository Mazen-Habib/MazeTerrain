{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    // noUncheckedIndexedAccess is deliberately OFF: every typed-array read in the
    // geometry hot loops would widen to `number | undefined`. Revisit for the OSM
    // tag-mapping tables in Phase 2, where it earns its keep.

    "types": ["vite/client"]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
